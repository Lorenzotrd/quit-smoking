  <script type="text/babel">
const { useRef: _uR, useEffect: _uE } = React;
function LungViz({ recovery = 0.4 }) {
  const mountRef = _uR(null);
  const recoveryRef = _uR(recovery);
  recoveryRef.current = recovery;
  _uE(() => {
    if (!window.THREE) return;
    const mount = mountRef.current;
    const w = mount.clientWidth, h = mount.clientHeight;
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(38, w / h, 0.1, 100);
    camera.position.set(0, 0, 9.5);
    const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
    renderer.setSize(w, h);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    mount.appendChild(renderer.domElement);
    scene.add(new THREE.AmbientLight(0xffffff, 0.35));
    const kl = new THREE.DirectionalLight(0x9be0b8, 1.2); kl.position.set(3, 4, 6); scene.add(kl);
    const rl = new THREE.DirectionalLight(0x4ad8a0, 0.6); rl.position.set(-4, -2, -3); scene.add(rl);
    const fl = new THREE.PointLight(0xa8f5d6, 0.7, 14); fl.position.set(-2, 0, 4); scene.add(fl);
    function makeLungGeo(side) {
      const geo = new THREE.SphereGeometry(1, 96, 96);
      const pos = geo.attributes.position;
      const v = new THREE.Vector3();
      for (let i = 0; i < pos.count; i++) {
        v.fromBufferAttribute(pos, i);
        v.y *= 1.45; v.x *= 0.9; v.z *= 0.92;
        const tf = Math.max(0, v.y - 1.0); v.y -= tf * 0.35;
        const inn = Math.max(0, v.x * -side); v.x -= inn * 0.55 * side;
        const ln = Math.sin(v.y * 2.6 + side * 0.4) * 0.06 + Math.cos(v.z * 3.1 + v.y * 0.5) * 0.04;
        v.multiplyScalar(1 + ln);
        const n = Math.sin(v.x * 7 + v.y * 3) * 0.012 + Math.cos(v.z * 8 - v.y * 4) * 0.012;
        v.multiplyScalar(1 + n);
        if (v.y < -0.6) v.x *= 1.05;
        pos.setXYZ(i, v.x, v.y, v.z);
      }
      geo.computeVertexNormals(); return geo;
    }
    const lg = new THREE.Group();
    const lm = new THREE.MeshPhysicalMaterial({ color: new THREE.Color(0x6ad79a), roughness: 0.55, metalness: 0, transmission: 0.15, thickness: 0.8, clearcoat: 0.35, sheen: 0.5, sheenColor: new THREE.Color(0x8ff0c0), emissive: new THREE.Color(0x1f5c3a), emissiveIntensity: 0.25 });
    const wm = new THREE.MeshBasicMaterial({ color: 0x83eab2, wireframe: true, transparent: true, opacity: 0.06 });
    const ll = new THREE.Mesh(makeLungGeo(-1), lm); ll.position.x = -0.85; ll.scale.set(0.95, 1, 1); lg.add(ll);
    const rl2 = new THREE.Mesh(makeLungGeo(1), lm); rl2.position.x = 0.85; lg.add(rl2);
    const lw = new THREE.Mesh(makeLungGeo(-1), wm); lw.position.x = -0.85; lw.scale.set(0.95, 1, 1).multiplyScalar(1.005); lg.add(lw);
    const rw = new THREE.Mesh(makeLungGeo(1), wm); rw.position.x = 0.85; rw.scale.setScalar(1.005); lg.add(rw);
    const tm = new THREE.MeshPhysicalMaterial({ color: 0xe8f5ea, roughness: 0.6, metalness: 0.05, emissive: 0x1a3a28, emissiveIntensity: 0.2 });
    const tr = new THREE.Mesh(new THREE.CylinderGeometry(0.16, 0.18, 1.2, 32), tm); tr.position.y = 1.6; lg.add(tr);
    const bL = new THREE.Mesh(new THREE.CylinderGeometry(0.1, 0.13, 0.7, 24), tm); bL.position.set(-0.45, 1.1, 0); bL.rotation.z = Math.PI / 4; lg.add(bL);
    const bR = new THREE.Mesh(new THREE.CylinderGeometry(0.1, 0.13, 0.7, 24), tm); bR.position.set(0.45, 1.1, 0); bR.rotation.z = -Math.PI / 4; lg.add(bR);
    lg.scale.setScalar(0.95); lg.position.y = -0.15; scene.add(lg);
    let raf; const t0 = performance.now();
    const animate = () => {
      const t = (performance.now() - t0) * 0.001;
      lg.rotation.y = t * 0.18; lg.rotation.x = Math.sin(t * 0.25) * 0.05;
      const br = 1 + Math.sin(t * 0.6) * 0.012;
      ll.scale.set(0.95 * br, br, br); rl2.scale.setScalar(br);
      const r = recoveryRef.current;
      const tgt = new THREE.Color().lerpColors(new THREE.Color(0x4a8c70), new THREE.Color(0x86f3b6), r);
      lm.color.lerp(tgt, 0.04); lm.emissiveIntensity = 0.18 + r * 0.25; wm.opacity = 0.04 + r * 0.06;
      renderer.render(scene, camera); raf = requestAnimationFrame(animate);
    };
    animate();
    const ro = new ResizeObserver(() => { const w2 = mount.clientWidth, h2 = mount.clientHeight; renderer.setSize(w2, h2); camera.aspect = w2 / h2; camera.updateProjectionMatrix(); });
    ro.observe(mount);
    return () => { cancelAnimationFrame(raf); ro.disconnect(); renderer.dispose(); if (mount.contains(renderer.domElement)) mount.removeChild(renderer.domElement); };
  }, []);
  return React.createElement('div', { ref: mountRef, className: 'lung-canvas' });
}
window.LungViz = LungViz;
  </script>

