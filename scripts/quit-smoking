}

function Footer({ days }) {
  return (
    <footer className="footer">
      <div className="day-of">Day <em>{days}</em> of being free.</div>
      <div className="tagline">"You are not quitting smoking. You are escaping a trap."</div>
      <div className="disclaimer">For accountability and motivation. Inspired by general quit-smoking principles. Not medical advice.</div>
    </footer>
  );
}

function App() {
  const [t, setTweak] = useTweaks(TWEAK_DEFAULTS);
  const today = new Date().toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' });
  const escapeStage = t.streakDays<3?0:t.streakDays<14?1:t.streakDays<60?2:t.streakDays<180?3:4;
  return (
