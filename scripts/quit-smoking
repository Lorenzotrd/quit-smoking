<script type="importmap">
{{
  "imports": {{
    "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
    "three/addons/": "https://unpkg.com/three@0.160.0/examples/jsm/"
  }}
}}
</script>
<script type="module">
import * as THREE from "three";
import {{ OrbitControls }} from "three/addons/controls/OrbitControls.js";
import {{ GLTFLoader }} from "three/addons/loaders/GLTFLoader.js";

const modelSrc = {model_src_json};
const darkness = {model_darkness_ratio};
const mount = document.getElementById("lung3d");

if (modelSrc && mount) {{
  const scene = new THREE.Scene();
  scene.background = null;

  const camera = new THREE.PerspectiveCamera(32, mount.clientWidth / mount.clientHeight, 0.01, 100);
  camera.position.set(0, 0.04, 3.7);

  const renderer = new THREE.WebGLRenderer({{ antialias: true, alpha: true }});
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setSize(mount.clientWidth, mount.clientHeight);
  renderer.outputColorSpace = THREE.SRGBColorSpace;
  mount.appendChild(renderer.domElement);

  const controls = new OrbitControls(camera, renderer.domElement);
  controls.enableDamping = true;
  controls.enablePan = false;
  controls.minDistance = 1.6;
  controls.maxDistance = 5;
  controls.autoRotate = true;
  controls.autoRotateSpeed = 0.6;

  scene.add(new THREE.HemisphereLight(0x111122, 0x050505, 1.8));
  const key = new THREE.DirectionalLight(0xffffff, 2.4);
  key.position.set(2.4, 3.2, 4);
  scene.add(key);
  const rim = new THREE.DirectionalLight(0x4ade80, 0.6);
  rim.position.set(-3, 1.8, -2);
  scene.add(rim);

  const loader = new GLTFLoader();
  loader.load(modelSrc, (gltf) => {{
    const root = gltf.scene;
    const box = new THREE.Box3().setFromObject(root);
    const center = box.getCenter(new THREE.Vector3());
    const size = box.getSize(new THREE.Vector3());
    const maxAxis = Math.max(size.x, size.y, size.z) || 1;
    root.position.sub(center);
    root.position.y -= 0.05;
    root.position.x += 0.03;
    root.scale.multiplyScalar(1.78 / maxAxis);

    const tarColor = new THREE.Color(0x120f13);
    const healthyColor = new THREE.Color(0xff8fb8);
    const dangerColor = new THREE.Color(0x272027);

    root.traverse((node) => {{
      if (!node.isMesh) return;
      const materials = Array.isArray(node.material) ? node.material : [node.material];
      const nextMaterials = materials.map((mat) => {{
        const cloned = mat.clone();
        const base = cloned.color ? cloned.color.clone() : healthyColor.clone();
        base.lerp(healthyColor, 0.25);
        base.lerp(dangerColor, darkness * 0.55);
        base.lerp(tarColor, darkness * 0.42);
        cloned.color = base;
        cloned.roughness = 0.82;
        cloned.metalness = 0.02;
        return cloned;
      }});
      node.material = Array.isArray(node.material) ? nextMaterials : nextMaterials[0];
    }});

    scene.add(root);
    controls.target.set(0, 0.02, 0);

    function animate() {{
      controls.update();
      renderer.render(scene, camera);
      requestAnimationFrame(animate);
    }}
    animate();
  }});

  window.addEventListener("resize", () => {{
    camera.aspect = mount.clientWidth / mount.clientHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(mount.clientWidth, mount.clientHeight);
  }});
}}
</script>
</body>
</html>
"""
    path = APP_DIR / "dashboard.html"
    path.write_text(html)
    return path


def open_dashboard(state):
    path = dashboard_html(state)
    webbrowser.open(path.as_uri())
    print(f"\nDashboard opened: {path}")


def micro_actions(state):
    print("\nQuit Smoking has locked this session.")
    print("Complete 3 micro-actions to unlock your project:\n")
    input("1) Do 10 push-ups. Press Enter when done.")
    state["total_pushups"] = int(state.get("total_pushups", 0)) + 10
    input("2) Drink a full glass of water. Press Enter when done.")
    state["total_water"] = int(state.get("total_water", 0)) + 1
    input("3) Wait 60 seconds and let the craving pass. Press Enter to start.")
    for seconds in range(60, 0, -10):
        print(f"{seconds}s... The craving is nicotine leaving your body. Let it leave.")
        time.sleep(10)
    state["total_waits"] = int(state.get("total_waits", 0)) + 1
    reason = ask("Write one sentence: what triggered the craving?")
    state["last_trigger"] = reason
    state["total_cravings_defeated"] = int(state.get("total_cravings_defeated", 0)) + 1
    log_event({"type": "micro_actions_completed", "reason": reason})
    save_state(state)
    open_dashboard(state)
    print("\nUnlocked. The craving has been defeated. The monster is a little weaker.\n")


def checkin(state):
    print(QUIT_ASCII)
    if not state.get("profile"):
        onboarding(state)

    print("\nBefore we code, a quick check is required.\n")
    smoked = ask("Did you smoke today? yes/no", "no").lower()
    craving_level = safe_int(ask("Craving level right now? 0-10", "0"), 0)
    trigger = ask("Main trigger right now? morning / coffee / stress / coding / after food / party / boredom", state.get("profile", {}).get("main_trigger", "coding")).lower()

    state["last_craving_level"] = craving_level
    state["last_trigger"] = trigger

    if smoked.startswith("y"):
        smoked_count = max(1, safe_int(ask("How many cigarettes today?", "1"), 1))
        state["last_smoked_count"] = smoked_count
        state["total_smoked_logged"] = int(state.get("total_smoked_logged", 0)) + smoked_count
        state["streak_days"] = 0
        state["last_clean_date"] = None
        save_state(state)
        log_event({"type": "smoked_today", "trigger": trigger, "craving_level": craving_level, "count": smoked_count})
        print("\nDisappointing, but not fatal. Reset the loop now.")
        open_dashboard(state)
        micro_actions(state)
    elif craving_level >= 5:
        state["last_smoked_count"] = 0
        save_state(state)
        log_event({"type": "strong_craving", "trigger": trigger, "craving_level": craving_level})
        print("\nHigh craving detected. Not today.")
        open_dashboard(state)
        micro_actions(state)
    else:
        state["last_smoked_count"] = 0
        update_clean_day(state)
        save_state(state)
        log_event({"type": "clean_checkin", "trigger": trigger, "craving_level": craving_level})
        print("\nClean streak updated. Your dashboard has evolved.")
        open_dashboard(state)


def run_agent(agent_cmd, args):
    path = shutil.which(agent_cmd)
    if not path:
        print(f"\nCould not find '{agent_cmd}' on PATH. Install it first, or run quit-smoking check manually.")
        sys.exit(1)
    os.execvp(path, [agent_cmd] + args)


def main():
    state = load_state()
    cmd = sys.argv[1] if len(sys.argv) >= 2 else "check"

    if cmd == "check":
        checkin(state)
    elif cmd == "dashboard":
        open_dashboard(state)
    elif cmd == "reset":
        if STATE_FILE.exists():
            STATE_FILE.unlink()
        print("Quit Smoking reset.")
    elif cmd in ("claude", "codex"):
        checkin(state)
        run_agent(cmd, sys.argv[2:])
    else:
        print("Usage:")
        print("  quit-smoking check")
        print("  quit-smoking dashboard")
        print("  quit-smoking reset")
        print("  quit-smoking claude [args...]")
        print("  quit-smoking codex [args...]")


if __name__ == "__main__":
    main()
