    </div>
  );
}

function Sparkline({ color="var(--green)", seed=1, trend="up" }) {
  const points = useMemo(() => {
    const n=14, r=i=>(Math.sin(i*1.7+seed)*0.5+Math.cos(i*0.7+seed*2)*0.5), arr=[];
    for (let i=0;i<n;i++) { const base=trend==='up'?i/(n-1):0.5; arr.push(Math.min(1,Math.max(0,base*0.7+(r(i)+1)/2*0.35+0.1))); }
    return arr;
  }, [seed, trend]);
  const w=88,h=36,p=2,step=(w-p*2)/(points.length-1);
  const path=points.map((y,i)=>`${i===0?'M':'L'} ${(p+i*step).toFixed(1)} ${(h-p-y*(h-p*2)).toFixed(1)}`).join(' ');
  return (
    <svg className="spark" viewBox={`0 0 ${w} ${h}`}>
      <defs><linearGradient id={`sp-${seed}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stopColor={color} stopOpacity="0.35"/><stop offset="100%" stopColor={color} stopOpacity="0"/></linearGradient></defs>
      <path d={`${path} L ${w-p} ${h} L ${p} ${h} Z`} fill={`url(#sp-${seed})`}/>
      <path d={path} fill="none" stroke={color} strokeWidth="1.4" strokeLinecap="round" strokeLinejoin="round"/>
    </svg>
  );
}

