          <TweakNumber label="Cigarettes / day" value={t.cigsPerDay} min={1} max={60} onChange={v=>setTweak('cigsPerDay',v)}/>
          <TweakNumber label="Cost / pack ($)" value={t.costPerPack} min={1} max={40} step={0.5} onChange={v=>setTweak('costPerPack',v)}/>
        </TweakSection>
        <TweakSection label="Today">
          <TweakSlider label="Current craving (0–10)" value={t.cravingNow} min={0} max={10} step={1} onChange={v=>setTweak('cravingNow',v)}/>
          <TweakNumber label="Cravings defeated" value={t.cravingsDefeated} min={0} max={500} onChange={v=>setTweak('cravingsDefeated',v)}/>
        </TweakSection>
        <TweakSection label="Display">
          <TweakRadio label="Today's reframe" value={t.reframeIndex} options={REFRAMES.map((_,i)=>({value:i,label:`0${i+1}`}))} onChange={v=>setTweak('reframeIndex',v)}/>
          <TweakToggle label="Show sparklines" value={t.showSparklines} onChange={v=>setTweak('showSparklines',v)}/>
        </TweakSection>
      </TweaksPanel>
