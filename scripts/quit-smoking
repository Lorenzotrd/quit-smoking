  return (
    <section className="card">
      <span className="eyebrow"><span className="tick"/>Right now</span>
      <h3 className="section-title">Craving intensity</h3>
      <div className="craving-num">
        <span className="v tabnum" style={{color}}>{value}</span>
        <span className="ten">/ 10</span>
      </div>
      <div className="craving-meter">
        <div className="cm-fill" style={{width:'100%'}}/>
        <div className="cm-mask" style={{width:`${100-value*10}%`}}/>
      </div>
      <div className="craving-status" style={{color}}>Status · {status}</div>
      <div className="craving-reassure">"{reassure}"</div>
    </section>
  );
}

function Triggers() {
  const triggers=[
    {name:'Stress',count:24,pct:1.0},{name:'After coffee',count:17,pct:0.7},
    {name:'After meals',count:12,pct:0.5},{name:'Deep work',count:9,pct:0.38},{name:'Social',count:6,pct:0.25},
  ];
  return (
    <section className="card">
      <span className="eyebrow"><span className="tick"/>Top triggers</span>
      <h3 className="section-title">What pulls hardest.</h3>
      <div className="trigger-list">
        {triggers.map((t,i)=>(
          <div key={t.name} className={`trigger${i===0?' top':''}`}>
            <span className="rank">{String(i+1).padStart(2,'0')}</span>
            <span className="name">{t.name}</span>
            <span className="count">{t.count}×</span>
            <div className="bar"><i style={{width:`${t.pct*100}%`}}/></div>
          </div>
        ))}
      </div>
    </section>
  );
}

function Reframe({ index }) {
  const r=REFRAMES[index%REFRAMES.length];
  const parts=r.text.split(r.accent);
  return (
    <section className="card reframe">
      <span className="reframe-eyebrow">Today's reframe</span>
      <div className="reframe-q">{parts[0]}<span className="accent">{r.accent}</span>{parts[1]}</div>
      <span className="reframe-attr">{r.attr}</span>
    </section>
  );
}

function EscapeStages({ stage=2 }) {
  return (
    <section className="card">
      <span className="eyebrow"><span className="tick"/>Your escape · stage {stage+1} of 5</span>
      <h3 className="section-title">The path out of the trap.</h3>
      <div className="stage-list">
        {ESCAPE_STAGES.map((s,i)=>{
          const st=i<stage?'done':i===stage?'current':'future';
          return (
            <div key={s.title} className={`stage ${st}`}>
              <div className="marker">{st==='done'?'✓':String(i+1).padStart(2,'0')}</div>
              <div>
                <div className="meta">{st==='current'?'You are here':st==='done'?'Cleared':s.meta}</div>
                <h4 className="title">{s.title}</h4>
                {st==='current'&&<p className="desc">{s.desc}</p>}
              </div>
            </div>
          );
        })}
      </div>
    </section>
  );
}

function RestorationTimeline({ days }) {
  return (
    <section className="card">
      <span className="eyebrow"><span className="tick"/>Lung restoration timeline</span>
      <h3 className="section-title">The long road home.</h3>
      <div className="timeline">
        {RESTORATION.map((r,i)=>{
          const req=RESTORATION_DAYS[i];
          const state=days>=req?'done':(days<req&&(i===0||days>=RESTORATION_DAYS[i-1]))?'next':'future';
          const rem=Math.max(0,req-days);
          let remStr=state==='done'?'Earned':state==='next'?(rem<1?`${Math.round(rem*24)}h left`:`${Math.ceil(rem)}d left`):'—';
          return (
            <div key={r.when} className={`tl-item ${state}`}>
              <div className="tl-dot"/>
              <div className="tl-body"><div className="t-when">{r.when}</div><div className="t-what">{r.what}</div></div>
              <div className="tl-meta">{remStr}</div>
            </div>
          );
        })}
      </div>
    </section>
  );
}

function Principles() {
  return (
    <section className="card">
      <span className="eyebrow"><span className="tick"/>The principles</span>
      <h3 className="section-title">Six things to keep close.</h3>
      <div className="principles">
        {PRINCIPLES.map(p=>(
          <div className="principle" key={p.title}>
            <div className="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round" strokeLinejoin="round"><path d={p.icon}/></svg></div>
            <h4>{p.title}</h4>
            <p>{p.body}</p>
          </div>
        ))}
      </div>
    </section>
  );
}

function TriggerProtocol() {
  return (
    <section className="card">
      <span className="eyebrow"><span className="tick"/>Trigger protocol · live</span>
      <h3 className="section-title">When stress hits, do this.</h3>
