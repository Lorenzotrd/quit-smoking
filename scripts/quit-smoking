function fmt(n, digits=0) { return typeof n === 'number' ? n.toLocaleString('en-US', { minimumFractionDigits: digits, maximumFractionDigits: digits }) : n; }
function useCountUp(target, duration=1200) {
  const [val, setVal] = useState(0);
  useEffect(() => {
    let raf; const t0 = performance.now();
    const tick = t => { const e = Math.min(1, (t-t0)/duration); const k = 1-Math.pow(1-e,3); setVal(target*k); if (e<1) raf=requestAnimationFrame(tick); };
    raf = requestAnimationFrame(tick);
    return () => cancelAnimationFrame(raf);
  }, [target]);
  return val;
}
function nextMilestone(d) { for (const m of MILESTONES) if (d < m) return m; return MILESTONES[MILESTONES.length-1]; }
function prevMilestone(d) { let p=0; for (const m of MILESTONES) { if (d<m) return p; p=m; } return p; }
function nextMilestoneLabel(m) {
  if (m<=3) return "first wall"; if (m<=7) return "first week"; if (m<=14) return "two-week mark";
  if (m<=21) return "three-week rewire"; if (m<=30) return "first month"; if (m<=60) return "second month";
  if (m<=90) return "quarter-year"; if (m<=180) return "half-year"; return "first year";
}

