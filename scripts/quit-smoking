def safe_int(value, default=0):
    try:
        return int(float(str(value).strip()))
    except Exception:
        return default


def safe_float(value, default=0.0):
    try:
        return float(str(value).strip())
    except Exception:
        return default


def save_state(state):
    APP_DIR.mkdir(exist_ok=True)
    STATE_FILE.write_text(json.dumps(state, indent=2))


def load_state():
    APP_DIR.mkdir(exist_ok=True)
    if not STATE_FILE.exists():
        state = DEFAULT_STATE.copy()
        state["created_at"] = datetime.now().isoformat()
        save_state(state)
        return state
    state = json.loads(STATE_FILE.read_text())
    for key, value in DEFAULT_STATE.items():
        state.setdefault(key, value)
    return state


def log_event(event):
    APP_DIR.mkdir(exist_ok=True)
    event["ts"] = datetime.now().isoformat()
    with LOG_FILE.open("a") as handle:
        handle.write(json.dumps(event) + "\n")


def ask(question, default=None):
    prompt = question
    if default is not None:
        prompt += f" [{default}]"
    answer = input(prompt + ": ").strip()
    return answer if answer else default


def calc_lifetime(profile):
    age_started = safe_int(profile.get("age_started", 18), 18)
    current_age = safe_int(profile.get("current_age", 30), 30)
    per_day = safe_int(profile.get("cigarettes_per_day", 10), 10)
    years = max(0, current_age - age_started)
    return years * 365 * per_day


def onboarding(state):
    print(QUIT_ASCII)
    print("\nFirst setup. Tell the system what it is fighting.\n")
    profile = {
        "current_age": ask("Current age?", "30"),
        "age_started": ask("Age when you started smoking?", "18"),
        "cigarettes_per_day": ask("Average cigarettes per day?", "10"),
        "main_trigger": ask("Biggest trigger? morning / coffee / stress / coding / after food / party / boredom", "coding").lower(),
        "hardest_cigarette": ask("Hardest cigarette to remove?", "morning"),
        "why_quit": ask("Why do you actually want to quit?", "freedom, health, money, discipline"),
        "gain_30_days": ask("What do you gain if you stop for 30 days?", "better lungs, money, focus"),
        "tone": ask("Mode? gentle / strict / toxic", "strict").lower(),
    }
    state["price_per_cigarette"] = safe_float(ask("Estimated price per cigarette in USD?", "0.50"), 0.5)
    state["profile"] = profile
    state["mode"] = profile["tone"]
    state["lifetime_cigarettes_estimate"] = calc_lifetime(profile)
    save_state(state)
    print("\nSetup complete. The addiction now has paperwork.\n")
    time.sleep(0.5)


def update_clean_day(state):
    today = date.today().isoformat()
    if state.get("last_clean_date") != today:
        state["streak_days"] = int(state.get("streak_days", 0)) + 1
        state["last_clean_date"] = today
        per_day = safe_int(state.get("profile", {}).get("cigarettes_per_day", 10), 10)
        state["total_cigarettes_avoided"] = int(state.get("total_cigarettes_avoided", 0)) + per_day
        save_state(state)


def get_current_stage(state):
    streak = int(state.get("streak_days", 0))
    if streak <= 1:
        return 1
    if streak <= 3:
        return 2
    if streak <= 7:
        return 3
    if streak <= 21:
        return 4
    return 5


def solution_cards_html(trigger):
    solutions = TRIGGER_SOLUTIONS.get((trigger or "coding").lower(), TRIGGER_SOLUTIONS["coding"])
    return "".join(
        f'<div class="tip-item"><span class="tip-check">✓</span><span>{item}</span></div>'
        for item in solutions
    )


def ensure_lung_asset():
    candidates = [
        LUNG_ASSET_FILE,
        pathlib.Path(__file__).resolve().parents[1] / "assets" / "lungs" / "lungs.glb",
        pathlib.Path.home() / "Downloads" / "QUICK SMOKING" / "lungs.glb",
        pathlib.Path.home() / "Downloads" / "quit smoking" / "lungs" / "lungs.glb",
    ]
    for candidate in candidates:
        if candidate.exists():
            LUNG_ASSET_FILE.parent.mkdir(parents=True, exist_ok=True)
            if candidate != LUNG_ASSET_FILE:
                shutil.copy(candidate, LUNG_ASSET_FILE)
            return LUNG_ASSET_FILE
    return None


def lung_model_data_uri():
    asset = ensure_lung_asset()
    if not asset:
        return ""
    encoded = base64.b64encode(asset.read_bytes()).decode("ascii")
    return f"data:model/gltf-binary;base64,{encoded}"


def dashboard_html(state):
    APP_DIR.mkdir(exist_ok=True)
    profile = state.get("profile", {})
    avoided = int(state.get("total_cigarettes_avoided", 0))
    saved = avoided * float(state.get("price_per_cigarette", 0.5))
    streak = int(state.get("streak_days", 0))
    cravings = int(state.get("total_cravings_defeated", 0))
    smoked = int(state.get("total_smoked_logged", 0))
    per_day = safe_int(profile.get("cigarettes_per_day", 10), 10)
    last_smoked_count = int(state.get("last_smoked_count", 0))
    lifetime = int(state.get("lifetime_cigarettes_estimate", calc_lifetime(profile)))
    trigger = state.get("last_trigger") or profile.get("main_trigger", "coding")
    craving = int(state.get("last_craving_level", 0))
    stage = get_current_stage(state)
    state["current_stage"] = stage
    save_state(state)

    # Lung darkness computation
    lifetime_dark_boost = min(25, lifetime / 1000)
    recovery = streak * 3 + cravings * 1.5
    relapse = smoked * 4 + last_smoked_count * 7 + craving * 2
    darkness = int(max(8, min(97, 65 + lifetime_dark_boost + relapse - recovery)))
    pinkness = 100 - darkness
    lung_r = int(35 + (220 * pinkness / 100))
    lung_g = int(20 + (80 * pinkness / 100))
    lung_b = int(20 + (105 * pinkness / 100))
    model_brightness = max(0.42, 1 - (darkness / 160))
    model_saturation = max(0.45, 1.15 - (darkness / 180))
    model_contrast = min(1.55, 1 + (darkness / 180))
    model_overlay_opacity = min(0.58, darkness / 150)
    soot_count = max(2, min(14, last_smoked_count + smoked))
    soot_marks = ""
    for index in range(soot_count):
        left = 9 + ((index * 23) % 82)
        top = 14 + ((index * 31) % 66)
        size = 10 + ((index * 7) % 22)
        opacity = min(0.36, 0.12 + darkness / 360)
        soot_marks += f'<span class="soot" style="left:{left}%; top:{top}%; width:{size}px; height:{size}px; opacity:{opacity};"></span>'

    model_src = lung_model_data_uri()
    model_src_json = json.dumps(model_src)
    model_darkness_ratio = round(darkness / 100, 3)

    # Daily reframe — rotates by day
    reframe_index = date.today().toordinal() % len(DAILY_REFRAMES)
    todays_reframe = DAILY_REFRAMES[reframe_index]
    reframe_num = reframe_index + 1

    # Allen Carr stage content
    carr_stage = ALLEN_CARR_STAGES[stage - 1]

    # Trigger solutions
    trigger_tips_html = solution_cards_html(trigger)

    # Event log for analytics
    events = []
    if LOG_FILE.exists():
        for line in LOG_FILE.read_text().splitlines()[-200:]:
            try:
                events.append(json.loads(line))
            except Exception:
                pass

    today = date.today()
    day_rows = []
    max_daily = 1
    for offset in range(6, -1, -1):
        current = today - timedelta(days=offset)
        key = current.isoformat()
        clean_events = sum(1 for e in events if e.get("ts", "").startswith(key) and e.get("type") == "clean_checkin")
        craving_events = sum(1 for e in events if e.get("ts", "").startswith(key) and e.get("type") in ("strong_craving", "micro_actions_completed"))
        smoke_events = sum(max(1, int(e.get("count", 1))) for e in events if e.get("ts", "").startswith(key) and e.get("type") == "smoked_today")
        value = clean_events + craving_events + smoke_events
        max_daily = max(max_daily, value)
        day_rows.append((current.strftime("%a"), clean_events, craving_events, smoke_events, value))

    trigger_counts = {}
    for event in events:
        event_trigger = event.get("trigger") or event.get("reason") or ""
        normalized = event_trigger.lower().strip()
        if normalized in TRIGGER_SOLUTIONS:
            trigger_counts[normalized] = trigger_counts.get(normalized, 0) + 1
    if not trigger_counts:
        trigger_counts[(trigger or "coding").lower()] = max(1, craving)

    trigger_bars = ""
    max_trigger = max(trigger_counts.values() or [1])
    for name, count in sorted(trigger_counts.items(), key=lambda item: item[1], reverse=True)[:5]:
        width = max(8, int((count / max_trigger) * 100))
        trigger_bars += f"""
        <div class="bar-row">
          <div class="bar-label">{name.title()}</div>
          <div class="bar-track"><span style="width:{width}%"></span></div>
          <div class="bar-value">{count}</div>
        </div>"""

    daily_bars = ""
    for label, clean_events, craving_events, smoke_events, value in day_rows:
        height = 18 + int((value / max_daily) * 70)
        clean_height = max(3, int(height * max(clean_events, 0) / max(value, 1)))
        craving_height = max(0, int(height * max(craving_events, 0) / max(value, 1)))
        smoke_height = max(0, height - clean_height - craving_height)
        daily_bars += f"""
        <div class="day-col">
          <div class="day-stack" style="height:{height}px">
            <span class="ds-clean" style="height:{clean_height}px"></span>
            <span class="ds-crave" style="height:{craving_height}px"></span>
            <span class="ds-smoke" style="height:{smoke_height}px"></span>
          </div>
          <div class="day-lbl">{label}</div>
        </div>"""

    # KPI data
    next_milestone = 3 if streak < 3 else 7 if streak < 7 else 21 if streak < 21 else 30
    milestone_progress = int(max(0, min(100, (streak / next_milestone) * 100)))
    craving_status = "Calm" if craving <= 3 else "Watch" if craving <= 6 else "Lockdown"
    today_avoided = max(0, per_day - last_smoked_count)

    # Stages HTML — compact numbered stepper
    stages_html = ""
    for i, s in enumerate(ALLEN_CARR_STAGES, start=1):
        is_active = i == stage
        is_done = i < stage
        state_class = "stage-active" if is_active else ("stage-done" if is_done else "stage-locked")
        num_display = "✓" if is_done else str(i)
        body_block = (
            f"<div class='sbody'>{s['body']}<br><br><em>{s['key']}</em></div>"
            if is_active else ""
        )
        stages_html += f"""
        <div class="stage-item {state_class}">
          <div class="sline"></div>
          <div class="snum">{num_display}</div>
          <div class="stage-body">
            <div class="stitle">{s["title"]}</div>
            <div class="ssub">{s["subtitle"]}</div>
            {body_block}
          </div>
        </div>"""

    time_saved_hrs = round((avoided * 7) / 60, 1)
    urgency_msg = (
        "The craving peaks in 3 minutes. Wait it out." if craving >= 7
        else "High craving — move your body for 60 seconds." if craving >= 5
        else "Craving is low. Keep the momentum."
    )

    # Lung restoration timeline HTML
    lung_milestones_html = ""
    next_found = False
    for days_needed, label, desc in LUNG_MILESTONES:
        if streak >= days_needed:
            cls = "lm-done"
            badge = "✓"
            days_info = label
        elif not next_found:
            cls = "lm-next"
            next_found = True
            badge = "→"
            days_remaining = max(1, int(days_needed - streak) + 1)
            days_info = f"{days_remaining} day{'s' if days_remaining != 1 else ''} left"
        else:
            cls = "lm-future"
            badge = "·"
            days_info = f"day {int(days_needed)}"
        lung_milestones_html += f"""
        <div class="lm-item {cls}">
          <div class="lm-badge">{badge}</div>
          <div class="lm-body">
            <span class="lm-label">{label}</span>
            <span class="lm-desc">{desc}</span>
          </div>
          <div class="lm-days">{days_info}</div>
        </div>"""

    # Allen Carr tips HTML
    tips_html = ""
    for tip in ALLEN_CARR_BOOK_TIPS:
        tips_html += f"""
        <div class="tip-card">
          <div class="tip-icon">{tip["icon"]}</div>
          <div class="tip-title">{tip["title"]}</div>
          <div class="tip-body">{tip["body"]}</div>
        </div>"""

    html = f"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Quit Smoking — Day {streak}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@1,300;1,400;1,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
*, *::before, *::after {{ box-sizing: border-box; margin: 0; padding: 0; }}

:root {{
  --bg:      #090909;
  --card:    #111111;
  --card2:   #161616;
  --border:  #1e1e1e;
  --border2: #2a2a2a;
  --text:    #efefef;
  --muted:   #5a5a5a;
  --dim:     #3a3a3a;
  --green:   #4ade80;
  --green2:  #22c55e;
  --red:     #f87171;
  --gold:    #c9a96e;
  --blue:    #60a5fa;
  --purple:  #a78bfa;
}}

body {{
  background: var(--bg);
  color: var(--text);
  font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
  min-height: 100vh;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}}

a {{ color: inherit; text-decoration: none; }}

/* ─── LAYOUT ─── */
.page {{ max-width: 1280px; margin: 0 auto; padding: 0 28px 80px; }}

/* top nav */
.topnav {{
  display: flex; align-items: center; justify-content: space-between;
  padding: 18px 0; border-bottom: 1px solid var(--border); margin-bottom: 32px;
